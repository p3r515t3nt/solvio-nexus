<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace REPLACE_ME with the local account before installation.
     Set absolute repository/runtime/state paths and create log directories.
     launchd arguments here are literal paths, not shell expressions.
     Core defaults are loopback only; configure private LAN/overlay bindings explicitly. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.solvio.core</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>SOLVIO_APPROVAL_HOST</key>
        <string>127.0.0.1</string>
        <key>SOLVIO_APPROVAL_PORT</key>
        <string>8770</string>
        <key>SOLVIO_APPROVAL_STATE_DIR</key>
        <string>/Users/REPLACE_ME/.solvio-approvals-production</string>
        
        <key>SOLVIO_APPROVAL_EXTRA_HOSTS</key>
        <string></string>
        
        <key>SOLVIO_REMOTE_ACCESS_ENDPOINTS</key>
        <string></string>
        
        <key>SOLVIO_SATELLITE_BIND</key>
        <string>127.0.0.1</string>
        <key>SOLVIO_DEEP_JAIL</key>
        <string>/Users/REPLACE_ME/.solvio-hermes</string>
        <key>SOLVIO_DEEP_STATE_DIR</key>
        <string>/Users/REPLACE_ME/.solvio-deep</string>
        <key>SOLVIO_RUNTIME_MODE</key>
        <string>production</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_ME/solvio-core/.venv/bin/python</string>
        <string>-m</string>
        <string>solvio.realtime.core_server</string>
        <string>--port</string>
        <string>8766</string>
        <string>--idle-timeout</string>
        <string>30</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME/solvio-core</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    
    <key>ExitTimeOut</key>
    <integer>90</integer>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/SOLVIO/Core/core.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/SOLVIO/Core/core.err.log</string>
</dict>
</plist>
