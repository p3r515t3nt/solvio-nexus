# SOLVIO Core, Beispielkonfiguration.
# Kopieren nach .env und dort die echten Werte eintragen.
# ACHTUNG: .env gehoert NICHT ins Repository, siehe .gitignore.
# Rechte der echten .env: chmod 600

# Zugang zur Sprach-KI (platform.openai.com, nicht das ChatGPT-Abo).
OPENAI_API_KEY=

# Realtime-Modell. Stand August 2026 ist gpt-realtime-2.1 allgemein
# verfuegbar. Leer lassen genuegt, dann greift der Vorgabewert im Code.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Agentenplanung/-bewertung ueber die angemeldete Abo-CLI.
# codex oder claude-code; kein automatischer Anbieter-/API-Wechsel bei Limit.
AGENT_RUNTIME_SUBSCRIPTION_PROVIDER=codex
# Leer = verfuegbares Standardmodell der CLI, keine feste Abostufe.
AGENT_RUNTIME_SUBSCRIPTION_MODEL=

# Native Hermes-Recherche: eigene offiziell angemeldete Codex-Konfiguration.
# Ohne Einrichtung bleibt der Weg unerreichbar; kein API-/Login-Rueckfall.
# N8 prueft Pfade, native Konfiguration und Zusatzkostenkontrolle gemeinsam.
AGENT_RUNTIME_HERMES_PYTHON=
AGENT_RUNTIME_HERMES_SOURCE=
AGENT_RUNTIME_HERMES_CODEX_BIN=
AGENT_RUNTIME_HERMES_CODEX_HOME=
AGENT_RUNTIME_HERMES_MODEL=

# N4: Erinnerungen ueber den gebuchten Abo-Weg. Kostenbeleg wird separat
# vor jedem Aufruf geprueft. Kein API-Fallback und kein automatischer Wechsel.
ADAPTIVE_MEMORY_ENABLED=true
ADAPTIVE_MEMORY_PROVIDER=codex
ADAPTIVE_MEMORY_MODEL=

# Lokaler SOLVIO-Dienst.
SOLVIO_HOST=127.0.0.1
SOLVIO_PORT=8765
SOLVIO_LOG_LEVEL=INFO

# Home Assistant, wird spaeter ueber eine Tool-Schicht angebunden.
HOME_ASSISTANT_URL=http://192.168.178.136:8123
HOME_ASSISTANT_TOKEN=

# Audio-Satellit (Raspberry Pi).
VOICE_SATELLITE_HOST=

# Private Browseroberflaeche: exakte HTTPS-Origins, kommagetrennt, keine Wildcards.
# Leer verwendet https://<Approval-LAN-Adresse>:<Approval-Port>.
SOLVIO_DASHBOARD_ORIGINS=

# Own Google mobile clients: configure matching IDs in the iOS app as well.
SOLVIO_GOOGLE_IOS_CLIENT_ID=configure-ios-client-id.apps.googleusercontent.com
SOLVIO_GOOGLE_SERVER_CLIENT_ID=configure-server-client-id.apps.googleusercontent.com
# Optional absolute paths: SOLVIO_GOOGLE_MOBILE_CONFIG, SOLVIO_GOOGLE_OAUTH_RUNTIME
